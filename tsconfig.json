// `npm run typecheck`: TypeScript checks web/'s JavaScript (app.js, the modules in web/js/ and dice.js) through its JSDoc
// comments. Nothing is emitted, so the shipped files stay exactly what's written. types/globals.d.ts declares the native
// bridges and the dice API.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // ES2024 is what both floors run (iOS 18's WebKit and Chrome 129), as in the ESLint configs, so a newer built-in
    // such as Promise.try (ES2025, Safari 18.2) is a type error. The DOM lib is always the latest;
    // `npm run lint:compat` checks DOM APIs against the floor.
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "types": [],
    // strict, except noImplicitAny, which web/js/logic/ turns on in tsconfig.logic.json (npm run typecheck runs both).
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["web/**/*.js", "types/*.d.ts"]
}
