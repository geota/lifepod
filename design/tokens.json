  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 650
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "heavy": {
        "$type": "fontWeight",
        "$value": 750
      }
    }
  },
  "type": {
    "score": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "clamp(2rem, 19vmin, 7rem)",
        "fontWeight": 750,
        "letterSpacing": "-0.055em",
        "lineHeight": 1
      },
      "$description": "tabular-nums"
    },
    "control": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "clamp(1.375rem, 10cqi, 1.75rem)",
        "fontWeight": 500,
        "lineHeight": 1
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "1.375rem",
        "fontWeight": 700,
        "letterSpacing": "-0.022em",
        "lineHeight": 1.35
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.35
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "0.875rem",
        "fontWeight": 650,
        "lineHeight": 1.35
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "0.8125rem",
        "fontWeight": 400,
        "lineHeight": 1.35
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "4rem",
        "fontWeight": 750,
        "letterSpacing": "-0.04em",
        "lineHeight": 1
      },
      "$description": "Store art headline"
    },
    "tagline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "1.5rem",
        "fontWeight": 550,
        "letterSpacing": "-0.01em",
        "lineHeight": 1.3
      },
      "$description": "Store art tagline"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "CHANGED: counter buttons were 9px."
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px"
    },
    "full": {
      "$type": "dimension",
      "$value": "999px"
    },
    "seat": {
      "$type": "number",
      "$value": 0.19,
      "$description": "Logo seat corner radius as a fraction of seat size"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "CHANGED: field error margin was 5px."
    },
    "2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "CHANGED: label margin was 7px."
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "CHANGED: sheet gap was 19px."
    }
  },
  "size": {
    "tap-min": {
      "$type": "dimension",
      "$value": "44px"
    },
    "seam-width": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "CHANGED: board gap was 1px [A1]."
    },
    "setup-button": {
      "$type": "dimension",
      "$value": "48px"
    },
    "setup-icon-stroke": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "CHANGED: was 1px [A3]."
    }
  },
  "shadow": {
    "dialog": {
      "$type": "shadow",
      "$value": {
        "color": "#0e130fd9",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "80px",
        "spread": "0px"
      }
    },
    "float": {
      "$type": "shadow",
      "$value": {
        "color": "#10161291",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "7px",
        "spread": "0px"
      }
    }
  },
  "motion": {
    "score-bump": {
      "$type": "duration",
      "$value": "160ms",
      "$description": "scale 1.08 → 1; off under prefers-reduced-motion"
    }
  }
}
